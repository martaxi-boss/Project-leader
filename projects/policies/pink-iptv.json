{
  "schema_version": "1.0",
  "policy_id": "pink-iptv-v1",
  "project": "PINK IPTV",
  "repository": "martaxi-boss/pink-iptv",
  "default_branch": "main",
  "effect_policies": {
    "E1_RECOVERABLE_PROJECT_LOCAL": {
      "allowed_scope_patterns": [
        "android/**",
        "backend/**",
        ".github/workflows/**",
        ".github/scripts/**",
        ".project-leader/**",
        ".env.example",
        "README.md",
        "PROJECT_STATE.md",
        "docs/**"
      ],
      "allowed_actions": [
        "create_branch",
        "edit_project_files",
        "create_commits",
        "run_ci",
        "open_or_update_pull_request"
      ],
      "required_prohibited_actions": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "production_deploy",
        "destructive_data_change",
        "repository_or_history_deletion",
        "production_secret_change",
        "irreversible_infrastructure_change",
        "paid_service_activation"
      ],
      "required_human_gates": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "production_deploy",
        "destructive_data_change",
        "production_secret_change",
        "irreversible_infrastructure_change",
        "paid_service_activation"
      ],
      "required_ci": [],
      "allowed_ci": [
        "Android CI",
        "Backend CI"
      ],
      "required_validation": [
        "Mutation scope audit",
        "GitHub evidence verification"
      ]
    }
  },
  "sensitive_paths": [
    "android/**",
    "backend/**",
    ".github/workflows/**",
    ".github/scripts/**",
    ".env.example"
  ],
  "protected_paths": [
    ".github/workflows/**",
    ".env*"
  ]
}
