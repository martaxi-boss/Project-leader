{
  "schema_version": "1.0",
  "policy_id": "vcam-pro-v1",
  "project": "VCAM-PRO",
  "repository": "martaxi-boss/VCAM-PRO",
  "default_branch": "main",
  "effect_policies": {
    "E1_RECOVERABLE_PROJECT_LOCAL": {
      "allowed_scope_patterns": [
        "src/**",
        "tests/**",
        "proofs/**",
        ".github/workflows/**",
        "Makefile",
        "control",
        ".project-leader/**"
      ],
      "allowed_actions": [
        "create_branch",
        "edit_project_files",
        "create_commits",
        "run_ci",
        "open_or_update_pull_request"
      ],
      "required_prohibited_actions": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "production_deploy",
        "destructive_data_change",
        "repository_or_history_deletion",
        "production_secret_change",
        "irreversible_infrastructure_change",
        "paid_service_activation"
      ],
      "required_human_gates": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "production_deploy",
        "destructive_data_change",
        "production_secret_change",
        "irreversible_infrastructure_change",
        "paid_service_activation"
      ],
      "required_ci": [],
      "allowed_ci": [
        "Frame Engine Stage A CI",
        "Frame Engine Stage B CI",
        "Frame Engine Stage C1 CI",
        "Frame Engine Stage D1 CI",
        "Frame Engine Stage D2 CI",
        "mediaserverd load probe build"
      ],
      "required_validation": [
        "Mutation scope audit",
        "GitHub evidence verification"
      ]
    }
  },
  "sensitive_paths": [
    "src/**",
    "tests/**",
    "proofs/**",
    ".github/workflows/**",
    "Makefile",
    "control"
  ],
  "protected_paths": [
    ".github/workflows/**"
  ]
}
