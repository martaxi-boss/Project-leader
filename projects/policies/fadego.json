{
  "schema_version": "1.0",
  "policy_id": "fadego-v1",
  "project": "FADEGO",
  "repository": "martaxi-boss/fadego",
  "default_branch": "main",
  "effect_policies": {
    "E1_RECOVERABLE_PROJECT_LOCAL": {
      "allowed_scope_patterns": [
        "prisma/**",
        "app/**",
        "src/**",
        ".github/workflows/**",
        ".project-leader/**",
        ".env*"
      ],
      "allowed_actions": [
        "create_branch",
        "edit_project_files",
        "create_commits",
        "run_ci",
        "open_or_update_pull_request",
        "merge_development_branch"
      ],
      "required_prohibited_actions": [
        "merge_to_main",
        "branch_protection_or_ruleset_change",
        "release_or_publish",
        "production_deploy",
        "destructive_data_change",
        "repository_or_history_deletion",
        "production_secret_change",
        "irreversible_infrastructure_change",
        "paid_service_activation"
      ],
      "required_human_gates": [
        "EXCLUSIVE_HUMAN_INTERVENTION",
        "NEW_UNCOVERED_MATERIAL_DECISION"
      ],
      "required_ci": [],
      "allowed_ci": [
        "CI"
      ],
      "required_validation": [
        "Mutation scope audit",
        "GitHub evidence verification"
      ]
    }
  },
  "sensitive_paths": [
    "prisma/**",
    "app/**",
    "src/**",
    ".github/workflows/**",
    ".env*"
  ],
  "protected_paths": [
    ".github/workflows/**",
    ".env*"
  ]
}
